<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LoveOS ❤️ Recovery Mode</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    overflow:hidden;
    background:linear-gradient(#0f172a,#1e3a8a,#312e81);
    color:white;
    height:100vh;
}

#sky{
    position:fixed;
    inset:0;
    overflow:hidden;
}

.star{
    position:absolute;
    width:3px;
    height:3px;
    background:white;
    border-radius:50%;
    animation:twinkle 2s infinite alternate;
}

@keyframes twinkle{
    from{opacity:.2;}
    to{opacity:1;}
}

.rain{
    position:absolute;
    width:2px;
    height:20px;
    background:rgba(255,255,255,.4);
    animation:rain 1s linear infinite;
}

@keyframes rain{
    from{transform:translateY(-50px);}
    to{transform:translateY(110vh);}
}

.heart{
    position:absolute;
    animation:float 8s linear infinite;
    pointer-events:none;
}

@keyframes float{
    from{transform:translateY(110vh);}
    to{transform:translateY(-100px);}
}

.window{
    position:absolute;
    top:50%;
    left:50%;
    transform:translate(-50%,-50%);
    width:700px;
    max-width:95%;
    background:rgba(255,255,255,.08);
    backdrop-filter:blur(12px);
    border-radius:20px;
    padding:30px;
    text-align:center;
    box-shadow:0 0 40px rgba(0,0,0,.4);
}

button{
    padding:12px 22px;
    margin:10px;
    border:none;
    border-radius:30px;
    cursor:pointer;
    font-size:16px;
    transition:.3s;
}

button:hover{
    transform:scale(1.05);
}

#garden{
    font-size:35px;
    min-height:50px;
    margin-top:15px;
}

#msg{
    margin-top:20px;
    font-size:20px;
}

#letter{
    display:none;
    margin-top:20px;
    background:white;
    color:#333;
    padding:20px;
    border-radius:15px;
    text-align:left;
    line-height:1.6;
}

.cup{
    font-size:70px;
    animation:bounce 2s infinite;
}

@keyframes bounce{
    50%{transform:translateY(-5px);}
}

.steam{
    position:absolute;
    font-size:20px;
    opacity:.4;
    animation:steam 2s infinite;
}

@keyframes steam{
    0%{transform:translateY(0);}
    100%{
        transform:translateY(-20px);
        opacity:0;
    }
}

@media(max-width:600px){

.window{
    padding:20px;
}

h1{
    font-size:28px;
}

button{
    width:100%;
}

#letter{
    max-height:250px;
    overflow:auto;
}

}
</style>

</head>

<body>

<div id="sky"></div>

<div class="window">

<h1>❤️ LoveOS Recovery Mode ❤️</h1>

<p>
Hi Ellie, I hope this little website makes you smile while you get better.
</p>

<br>

<div style="position:relative;height:90px;">
<div class="steam" style="left:48%">☁️</div>
<div class="cup">☕</div>
</div>

<div style="font-size:80px;">🧸</div>

<button onclick="openLetter()">💌 Open Letter</button>

<button onclick="growFlower()">🌸 Grow Flower</button>

<button onclick="showMessage()">✨ Surprise Me</button>

<div id="garden"></div>

<div id="msg"></div>

<div id="letter">

<h2>To My Favorite Person ❤️</h2>

<p>
I know you're not feeling your best today.
If I could, I'd trade places with you so you didn't have to be sick.

I hope this little website reminds you how loved you are.

Take your time to rest, drink lots of water, and know that I'm thinking about you every moment.

You'll be smiling again very soon.

❤️ Get well soon ❤️
</p>

</div>

</div>

<script>

const sky=document.getElementById("sky");

for(let i=0;i<120;i++){

const star=document.createElement("div");
star.className="star";
star.style.left=Math.random()*100+"vw";
star.style.top=Math.random()*100+"vh";
star.style.animationDelay=Math.random()*2+"s";
sky.appendChild(star);

}

for(let i=0;i<180;i++){

const rain=document.createElement("div");
rain.className="rain";
rain.style.left=Math.random()*100+"vw";
rain.style.animationDelay=Math.random()+"s";
sky.appendChild(rain);

}

setInterval(()=>{

const heart=document.createElement("div");

heart.className="heart";

heart.innerHTML="❤️";

heart.style.left=Math.random()*100+"vw";

heart.style.fontSize=(18+Math.random()*20)+"px";

document.body.appendChild(heart);

setTimeout(()=>heart.remove(),8000);

},500);

const flowers=[
"🌸",
"🌼",
"🌷",
"🌻",
"🌺",
"💐"
];

const messages=[

"You're amazing ❤️",

"I'm thinking about you.",

"Sending you a giant hug 🤗",

"You'll be better soon 🌸",

"You make my world brighter.",

"I love you so much ❤️",

"Drink some water 💧",

"Rest well 💤"

];

function growFlower(){

document.getElementById("garden").innerHTML+=flowers[Math.floor(Math.random()*flowers.length)];

}

function showMessage(){

document.getElementById("msg").innerHTML=messages[Math.floor(Math.random()*messages.length)];

}

function openLetter(){

document.getElementById("letter").style.display="block";

}

</script>

</body>
</html>
